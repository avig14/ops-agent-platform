# Copy to .env (never commit .env). Real environment variables win over this file.

# Postgres. Local default matches docker-compose.yml. Production: Neon DIRECT (non-pooled) connection string
# with ?sslmode=require
DATABASE_URL=postgresql://ops:ops@localhost:5433/ops

# Gemini API key (https://aistudio.google.com/apikey). Without it the app still runs on the rule-based fallback.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# LLM_RPM=5
# LLM_DAILY_CAP=300

# dev | prod. prod refuses to start with the default JWT secret and sets Secure cookies (needs https).
APP_ENV=dev
# Required in prod. At least 32 random bytes:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Demo switches (failure injection and business-clock time travel on the Admin page).
ENABLE_CHAOS=1
ENABLE_CLOCK_OFFSET=1

# Background sweeps: seconds while the app is in use / while idle. A long idle value lets a free hosted Postgres sleep.
LOOP_INTERVAL_S=5
LOOP_IDLE_S=5

# Minimum seconds between "Retry the analysis" clicks on one case (stops churn while the AI is flaky).
RETRY_COOLDOWN_S=60
